# Parallax 2.0 — environment variables
# Set these in Cloudflare Pages → Settings → Environment variables (mark secrets as
# "Encrypted"). NEVER commit real values. This file documents the names only.

# --- auth (either naming pair works; login.js accepts both) ---
APP_USER=pixel
APP_PASS=change-me
# AUTH_USERNAME / AUTH_PASSWORD are accepted as aliases.

# --- session signing ---
SESSION_SECRET=generate-a-long-random-string   # e.g. openssl rand -hex 32

# --- thinking/chat providers (needed now) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- media providers (add when ready; prompt half works without them) ---
VENICE_API_KEY=            # enables Video (Seedance 2.0) + Image generation
FAL_API_KEY=               # optional fallback video provider

# --- optional: default model used by the video/image prompt-writer ---
DEFAULT_PROMPT_MODEL=claude-sonnet-4-20250514
