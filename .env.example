# Parallax — environment variables
# Set these in Cloudflare Pages → Settings → Variables and secrets (mark secrets as
# "Encrypted"). This file documents NAMES ONLY — never commit real values.
#
# Secrets only reach a Function on a NEW deployment. Adding one changes nothing until
# you redeploy.

# --- operator login (either naming pair works; login.js accepts both) ---
APP_USER=you
APP_PASS=change-me
# AUTH_USERNAME / AUTH_PASSWORD are accepted as aliases.

# --- session signing (required) ---
SESSION_SECRET=generate-a-long-random-string   # openssl rand -hex 32

# --- demo account ---
# The passwordless "demo" login is ON by default. Each demo login mints a private,
# throwaway workspace that expires after 24 hours.
# DEMO_MODE=off            # turn the demo off entirely
# DEMO_SHARED_KEYS=on      # let demo visitors spend YOUR provider credit. Off by default:
#                          # without it they must connect their own key to generate.

# --- thinking providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- media providers (optional; the prompt-writing half works without them) ---
VENICE_API_KEY=            # image + Seedance video
ARTCRAFT_API_KEY=
ARTCRAFT_BASE_URL=

# --- optional: read org-wide spend. Admin keys are NEVER shared with demo users. ---
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=

# --- optional: default model for the video/image prompt-writer ---
DEFAULT_PROMPT_MODEL=

# --- optional: Studio Console (/console/) — refused for demo users ---
GITHUB_TOKEN=
GITHUB_REPO=your-user/your-repo
GITHUB_BRANCH=main
SITE_URL=
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_PAGES_PROJECT=
